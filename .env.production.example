# ────────────────────────────────────────────────────────────────────
# Production-конфигурация. Скопируйте в .env и заполните все CHANGE_ME.
# Файл .env не попадает в git.
# ────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
# Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_RANDOM_64_CHARS
# Реальный HTTPS-адрес сайта. От него зависят QR-коды и ссылки в SMS.
PUBLIC_BASE_URL=https://rybnaya-lavka.by
# https://localhost — origin Android-приложения Capacitor (androidScheme=https)
# capacitor://localhost — origin iOS-приложения Capacitor (iosScheme=capacitor)
CORS_ORIGINS=https://rybnaya-lavka.by,https://www.rybnaya-lavka.by,https://localhost,http://localhost,capacitor://localhost

# ─── PostgreSQL (docker compose) ────────────────────────────────────
POSTGRES_DB=rybnaya
POSTGRES_USER=rybnaya
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
# Пароль в URL должен совпадать с POSTGRES_PASSWORD.
# Если в пароле есть @ : / ? #, закодируйте его URL-encoding.
DATABASE_URL=postgresql+psycopg://rybnaya:CHANGE_ME_DB_PASSWORD@db:5432/rybnaya

# ─── Файлы ──────────────────────────────────────────────────────────
MEDIA_ROOT=/app/backend/media
UPLOAD_MAX_MB=8

# ─── SMS (обязательное подтверждение номера) ────────────────────────
# console — только для локальной разработки, в production коды не доставляются.
# smsby   — SMS.BY
# websms  — WebSMS.BY (не забудьте изменить SMS_API_URL)
SMS_PROVIDER=smsby
SMS_EXPOSE_CODE=false
SMS_API_URL=https://api.sms.by/api/v1/message/send
SMS_API_TOKEN=CHANGE_ME_SMS_TOKEN
SMS_LOGIN=
SMS_PASSWORD=
SMS_SENDER=
SMS_CODE_TTL_MINUTES=5
SMS_COOLDOWN_SECONDS=60
SMS_MAX_PER_HOUR=5

# ─── Первичный администратор ────────────────────────────────────────
# Создаётся при первом запуске. После входа смените пароль.
ADMIN_PHONE=+375291112233
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_NAME=Владелец павильона

# ─── Наполнение базы ────────────────────────────────────────────────
# false — не создавать демо-продавца/покупателя с известными паролями.
SEED_DEMO=false
# true — один раз добавить 15 видов рыбы со статьями; потом редактируйте в админке.
SEED_CATALOG=true

# ─── Сборка фронтенда в Docker ──────────────────────────────────────
VITE_API_BASE_URL=/api
