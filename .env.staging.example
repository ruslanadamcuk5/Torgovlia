# ────────────────────────────────────────────────────────────────────
# Staging-конфигурация. Скопируйте в backend/.env или .env и заполните
# CHANGE_ME. Staging — отдельная база и отдельный домен, не Production.
# ────────────────────────────────────────────────────────────────────
ENVIRONMENT=staging
DEBUG=false
# Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_RANDOM_64_CHARS
# Адрес стенда. По нему строятся ссылки в письмах и QR-кодах.
PUBLIC_BASE_URL=https://staging.example.by
CORS_ORIGINS=https://staging.example.by

# ─── База ───────────────────────────────────────────────────────────
# Для стенда на одном сервере достаточно SQLite. Для проверки PostgreSQL
# используйте postgresql+psycopg://user:password@host:5432/dbname.
DATABASE_URL=sqlite:///./data/staging.db

# ─── Платформа ──────────────────────────────────────────────────────
PLATFORM_HOST=staging.example.by
PLATFORM_BASE_DOMAIN=staging.example.by
DEFAULT_TENANT_SLUG=rybnaya
# На staging проверяем боевое поведение: заголовок X-Tenant-Slug выключен,
# магазины открываются по поддоменам (<slug>.staging.example.by).
TENANT_HEADER_ENABLED=false
DEMO_MODE=false
DEMO_TENANT_SLUG=odezhda

# ─── Файлы ──────────────────────────────────────────────────────────
MEDIA_ROOT=media
UPLOAD_MAX_MB=8

# ─── SMS ────────────────────────────────────────────────────────────
# На staging коды печатаются в лог, реальные SMS не тратятся.
SMS_PROVIDER=console
SMS_EXPOSE_CODE=true
SMS_CODE_TTL_MINUTES=5

# ─── Первичные пользователи ─────────────────────────────────────────
# Пароли только для стенда. Не используйте их в production.
ADMIN_PHONE=+375291112233
ADMIN_PASSWORD=CHANGE_ME_STAGING_ADMIN_PASSWORD
ADMIN_NAME=Владелец магазина
PLATFORM_ADMIN_PHONE=+375291110000
PLATFORM_ADMIN_PASSWORD=CHANGE_ME_STAGING_PLATFORM_PASSWORD
PLATFORM_ADMIN_NAME=Владелец платформы

# ─── Наполнение ─────────────────────────────────────────────────────
SEED_DEMO=true
SEED_CATALOG=true

# ─── Уведомления (необязательно) ────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Токен плановой проверки /api/platform/ops/cron (scripts/uptime_check.py).
CRON_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
