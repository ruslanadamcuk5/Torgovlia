[Unit]
Description=Rybnaya Lavka FastAPI
After=network.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/rybnaya-lavka/backend
EnvironmentFile=/opt/rybnaya-lavka/.env
ExecStart=/opt/rybnaya-lavka/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/rybnaya-lavka/backend/data /opt/rybnaya-lavka/backend/media

[Install]
WantedBy=multi-user.target
