# ─── Основные настройки ─────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=CHANGE_ME_random_64_chars
# Публичный адрес сайта (нужен для QR-кодов и ссылок в SMS)
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,capacitor://localhost

# ─── База данных ────────────────────────────────────────────────────
# SQLite для старта. Для production рекомендуется PostgreSQL:
# postgresql+psycopg://user:password@db:5432/rybnaya
DATABASE_URL=sqlite:///./data/rybnaya.db

# ─── Платформа (multi-tenancy) ──────────────────────────────────────
# Домен сайта продаж и панели платформы.
PLATFORM_HOST=localhost
# Поддомены арендаторов: <slug>.<PLATFORM_BASE_DOMAIN>
PLATFORM_BASE_DOMAIN=localhost
# Арендатор по умолчанию (магазин, который работает без поддомена).
DEFAULT_TENANT_SLUG=rybnaya
# Выбор арендатора заголовком X-Tenant-Slug. В production всегда false.
TENANT_HEADER_ENABLED=true
# Демо-стенд на одном origin (/shop/<slug>). Для боевого сайта — false.
DEMO_MODE=false
# Флагманское демо на сайте продаж: магазин, доступы и период автосброса.
DEMO_TENANT_SLUG=odezhda
DEMO_ADMIN_PHONE=+375291112288
DEMO_ADMIN_PASSWORD=ChangeMe123!
DEMO_RESET_HOURS=24
# Полное наполнение демо (товары, заказы, отзывы, чаты).
DEMO_CONTENT=true

# ─── Файлы ──────────────────────────────────────────────────────────
MEDIA_ROOT=media
UPLOAD_MAX_MB=8

# ─── SMS (обязательная проверка номера) ─────────────────────────────
# console — код выводится в лог сервера (только для разработки)
# smsby   — SMS.BY (Республика Беларусь)
# websms  — WebSMS.BY (Республика Беларусь)
SMS_PROVIDER=console
SMS_EXPOSE_CODE=true
SMS_API_URL=https://api.sms.by/api/v1/message/send
SMS_API_TOKEN=
SMS_LOGIN=
SMS_PASSWORD=
SMS_SENDER=
SMS_CODE_TTL_MINUTES=5
SMS_COOLDOWN_SECONDS=60
SMS_MAX_PER_HOUR=5

# ─── Первичный администратор (создаётся при первом запуске) ─────────
ADMIN_PHONE=+375291112233
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Владелец

# ─── Владелец платформы (отдельный вход /platform) ───────────────────
PLATFORM_ADMIN_PHONE=+375291110000
PLATFORM_ADMIN_PASSWORD=ChangeMe123!
PLATFORM_ADMIN_NAME=Владелец платформы

# ─── Демо-данные ────────────────────────────────────────────────────
# SEED_DEMO=true создаёт тестовых продавца и покупателя с известными паролями.
# В production обязательно false.
SEED_DEMO=true
# SEED_CATALOG=true наполняет пустую базу 15 видами рыбы со статьями.
# Повторный запуск ничего не дублирует.
SEED_CATALOG=true

# ─── Оповещения платформы в Telegram (необязательно) ────────────────
# Создайте бота через @BotFather, добавьте его в чат и узнайте chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
